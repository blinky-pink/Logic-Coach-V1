{% extends 'base.html.twig' %}

{% block title %}Boîte de réception{% endblock %}

{% block body %}

<div class="message-page">

    <div class="message-container">

        <div class="message-header">
            <h1>Boîte de réception</h1>

            <a href="{{ path('app_message_new') }}" class="message-new-button">
                Nouveau message
            </a>
        </div>

        <div class="message-table-wrapper">

            <table class="message-table">

                <thead>
                    <tr>
                        <th>Expéditeur</th>
                        <th>Message</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                {% for message in messages %}

                    <tr>

                        <td>{{ message.sender.email }}</td>

                        <td>{{ message.message }}</td>

                        <td>
                            {{ message.createdAt ? message.createdAt|date('d/m/Y H:i') : '' }}
                        </td>

                        <td>
                            <a class="message-read-link" href="{{ path('app_message_show', {'id': message.id}) }}">
                                Lire
                            </a>
                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td class="message-empty-cell" colspan="4">
                            Aucun message.
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

{% endblock %}