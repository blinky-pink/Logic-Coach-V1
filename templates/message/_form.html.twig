{{ form_start(form, {'attr': {'class': 'message-form'}}) }}

    <div class="message-field">
        {{ form_label(form.receiver) }}
        {{ form_widget(form.receiver) }}
    </div>

    <div class="message-field">
        {{ form_label(form.message) }}
        {{ form_widget(form.message) }}
    </div>

    <button class="message-submit-button">{{ button_label|default('Envoyer') }}</button>

{{ form_end(form) }}