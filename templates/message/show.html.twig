{% extends 'base.html.twig' %}

{% block title %}Lecture du message{% endblock %}

{% block body %}

<div class="message-page">

    <div class="message-container">

        <div class="message-header">
            <h1>Lecture du message</h1>
        </div>

        <div class="message-detail">

            <div class="message-table-wrapper">

                <table class="message-table">

                    <tbody>

                        <tr>
                            <th>Expéditeur</th>
                            <td>{{ message.sender.email }}</td>
                        </tr>

                        <tr>
                            <th>Destinataire</th>
                            <td>{{ message.receiver.email }}</td>
                        </tr>

                        <tr>
                            <th>Date</th>
                            <td>{{ message.createdAt|date('d/m/Y H:i') }}</td>
                        </tr>

                        <tr>
                            <th>Message</th>
                            <td>{{ message.message|nl2br }}</td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

        <div class="message-footer-actions">

            <a class="message-back-button" href="{{ path('app_message_index') }}">
                Retour
            </a>

            {% if app.user == message.sender %}
                <a class="message-edit-button"
                   href="{{ path('app_message_edit', {'id': message.id}) }}">
                    Modifier
                </a>

                {{ include('message/_delete_form.html.twig') }}
            {% endif %}

        </div>

    </div>

</div>

{% endblock %}