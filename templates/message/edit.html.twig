{% extends 'base.html.twig' %}

{% block title %}Modifier le message - Logic Coach{% endblock %}

{% block body %}

<div class="message-page">

    <div class="message-container">

        <div class="message-header">
            <h1>Modifier le message</h1>
        </div>

        {{ include('message/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

        <div class="message-actions">
            <a class="message-back-button" href="{{ path('app_message_index') }}">
                Retour à la boîte de réception
            </a>

            {{ include('message/_delete_form.html.twig') }}
        </div>

    </div>

</div>

{% endblock %}