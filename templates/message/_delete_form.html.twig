<form method="post" action="{{ path('app_message_delete', {'id': message.id}) }}" class="message-delete-form" onsubmit="return confirm('Voulez-vous vraiment supprimer ce message ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.id) }}">
    <button class="message-delete-button">Supprimer</button>
</form>