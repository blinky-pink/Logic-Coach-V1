<form method="post" action="{{ path('app_theme_delete', {'id': theme.id}) }}" class="admin-delete-form" onsubmit="return confirm('Voulez-vous vraiment supprimer ce thème ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ theme.id) }}">
    <button class="admin-delete-button">Supprimer</button>
</form>
