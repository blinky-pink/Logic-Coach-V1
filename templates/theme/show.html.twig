{% extends 'base.html.twig' %}

{% block title %}Thème - Logic Coach{% endblock %}

{% block body %}

<div class="admin-page">

    <div class="admin-container">

        <div class="admin-header">
            <h1>Thème</h1>
        </div>

        <div class="admin-detail">

            <div class="admin-table-wrapper">

                <table class="admin-table">
                    <tbody>
                        <tr>
                            <th>Id</th>
                            <td>{{ theme.id }}</td>
                        </tr>
                        <tr>
                            <th>Nom</th>
                            <td>{{ theme.name }}</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ theme.description }}</td>
                        </tr>
                        <tr>
                            <th>Illustration</th>
                            <td>{{ theme.illustration }}</td>
                        </tr>
                        <tr>
                            <th>Couleur principale</th>
                            <td>{{ theme.primaryColor }}</td>
                        </tr>
                        <tr>
                            <th>Créé le</th>
                            <td>{{ theme.createdAt ? theme.createdAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                        <tr>
                            <th>Modifié le</th>
                            <td>{{ theme.updatedAt ? theme.updatedAt|date('d/m/Y H:i') : '' }}</td>
                        </tr>
                    </tbody>
                </table>

            </div>

        </div>

        <div class="admin-footer-actions">

            <a class="admin-back-button" href="{{ path('app_theme_index') }}">
                Retour à la liste
            </a>

            <a class="admin-edit-button" href="{{ path('app_theme_edit', {'id': theme.id}) }}">
                Modifier
            </a>

            {{ include('theme/_delete_form.html.twig') }}

        </div>

    </div>

</div>

{% endblock %}