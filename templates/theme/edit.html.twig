{% extends 'base.html.twig' %}

{% block title %}Modifier le thème - Logic Coach{% endblock %}

{% block body %}

<div class="admin-page admin-page--themes">

    <div class="admin-container">

        <div class="admin-header">
            <h1>Modifier le thème</h1>
        </div>

        {{ include('theme/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

        <div class="admin-actions">
            <a class="admin-back-button" href="{{ path('app_theme_index') }}">
                Retour à la liste
            </a>

            {{ include('theme/_delete_form.html.twig') }}
        </div>

    </div>

</div>

{% endblock %}