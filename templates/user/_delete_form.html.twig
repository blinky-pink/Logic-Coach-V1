<form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" class="admin-delete-form" onsubmit="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="admin-delete-button">Supprimer</button>
</form>
