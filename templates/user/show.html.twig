{% extends 'base.html.twig' %}

{% block title %}Utilisateur - Logic Coach{% endblock %}

{% block body %}

<div class="admin-page admin-page--users">

    <div class="admin-container">

        <div class="admin-header">
            <h1>Utilisateur</h1>
        </div>

        <div class="admin-detail">

            <div class="admin-table-wrapper">

                <table class="admin-table">
                    <tbody>
                        <tr>
                            <th>Id</th>
                            <td>{{ user.id }}</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>{{ user.email }}</td>
                        </tr>
                        <tr>
                            <th>Rôles</th>
                            <td>{{ user.roles|join(', ') }}</td>
                        </tr>
                    </tbody>
                </table>

            </div>

        </div>

        <div class="admin-footer-actions">

            <a class="admin-back-button" href="{{ path('app_user_index') }}">
                Retour à la liste
            </a>

            <a class="admin-edit-button" href="{{ path('app_user_edit', {'id': user.id}) }}">
                Modifier
            </a>

            {{ include('user/_delete_form.html.twig') }}

        </div>

    </div>

</div>

{% endblock %}