{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - Logic Coach{% endblock %}

{% block body %}

<div class="admin-page admin-page--users">

    <div class="admin-container">

        <div class="admin-header">
            <h1>Gestion des utilisateurs</h1>

            <a href="{{ path('app_user_new') }}" class="admin-new-button">
                Créer un utilisateur
            </a>
        </div>

        <div class="admin-table-wrapper">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Email</th>
                        <th>Rôles</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                {% for user in users %}

                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.roles|join(', ') }}</td>
                        <td>
                            <div class="admin-table-actions">
                                <a class="admin-show-link" href="{{ path('app_user_show', {'id': user.id}) }}">Voir</a>
                                <a class="admin-edit-button" href="{{ path('app_user_edit', {'id': user.id}) }}">Modifier</a>
                            </div>
                        </td>
                    </tr>

                {% else %}

                    <tr>
                        <td class="admin-empty-cell" colspan="4">Aucun utilisateur.</td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

{% endblock %}